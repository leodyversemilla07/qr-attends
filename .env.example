# Convex Environment Configuration
# Copy this file to .env.local and update values

# =============================================================================
# DEVELOPMENT ENVIRONMENT
# =============================================================================
# Run: npx convex dev
CONVEX_DEPLOYMENT=dev:dazzling-anaconda-162
CONVEX_SITE_URL=http://127.0.0.1:8181
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:8181

# =============================================================================
# PRODUCTION ENVIRONMENT
# =============================================================================
# Deployment URL: https://glorious-axolotl-616.convex.cloud
# HTTP Actions URL: https://glorious-axolotl-616.convex.site
CONVEX_PRODUCTION_URL=https://glorious-axolotl-616.convex.cloud
CONVEX_PRODUCTION_SITE_URL=https://glorious-axolotl-616.convex.site

# =============================================================================
# ACTIVE ENVIRONMENT
# =============================================================================
# Set to "dev" for development, "production" for live deployment
ACTIVE_ENVIRONMENT=dev

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Token encryption key - MUST be set to a secure random string in production
# Generate with: openssl rand -base64 32
# IMPORTANT: Never commit the actual key to version control!
TOKEN_ENCRYPTION_KEY=your-secure-random-key-here-at-least-32-chars

# =============================================================================
# ADMIN SEEDING CONFIGURATION (Optional)
# =============================================================================
# If not set, the seed script will generate a secure random password
# and log it to the Convex dashboard (check function logs after seeding)
# ADMIN_EMAIL=admin@yourorganization.com
# ADMIN_NAME=System Administrator
# ADMIN_PASSWORD=your-secure-password-here

# =============================================================================
# EAS Build Configuration
# =============================================================================
# For production builds, use:
# eas build --environment production
