# Convex Environment Configuration
# Copy this file to .env.local and update values

# =============================================================================
# DEVELOPMENT ENVIRONMENT
# =============================================================================
# Run: npx convex dev
CONVEX_DEPLOYMENT=dev:dazzling-anaconda-162
CONVEX_SITE_URL=http://127.0.0.1:8181
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:8181

# =============================================================================
# PRODUCTION ENVIRONMENT
# =============================================================================
# Deployment URL: https://glorious-axolotl-616.convex.cloud
# HTTP Actions URL: https://glorious-axolotl-616.convex.site
CONVEX_PRODUCTION_URL=https://glorious-axolotl-616.convex.cloud
CONVEX_PRODUCTION_SITE_URL=https://glorious-axolotl-616.convex.site

# =============================================================================
# ACTIVE ENVIRONMENT
# =============================================================================
# Set to "dev" for development, "production" for live deployment
ACTIVE_ENVIRONMENT=dev

# =============================================================================
# EAS Build Configuration
# =============================================================================
# For production builds, use:
# eas build --environment production
