# Environment Variables Example
# Copy this file to .env and update with your values

# JWT Secret Key (REQUIRED - MUST be 32+ characters in production!)
# Generate with: openssl rand -base64 32
JWT_SECRET=supersecret-change-in-production-to-a-long-random-string

# Deno KV Database Path
DENO_KV_PATH=/data/kv.db

# Environment (development or production)
DENO_ENV=production

# Application Port (default: 8000)
PORT=8000

# Allowed CORS Origins (comma-separated, for production)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=
